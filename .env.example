# =============================================================================
# Compras Paraguay — variáveis de ambiente
# Copie para .env (ou .env.local) e preencha. Na Vercel: Project → Settings → Environment Variables.
# =============================================================================

# --- Banco de dados (Neon Postgres) — Sprint 5 ---
# Connection string do Neon (use a "Pooled connection"). Sem ela, /api/track vira no-op.
DATABASE_URL=""

# --- Meta Pixel (Facebook) — opcional ---
# O Pixel ID já tem default embutido no código (é público). Defina aqui só para sobrescrever.
NEXT_PUBLIC_META_PIXEL_ID=""

# --- Meta Conversions API (CAPI, server-side) — captura de Lead à prova de AdBlock/iOS ---
# Token de System User do Events Manager → Configurações → API de Conversões → Gerar token.
# SECRETO (nunca commitar). Sem ele, o envio server-side do Lead vira no-op (Pixel front-end segue normal).
META_CAPI_TOKEN=""

# Código de TESTE do CAPI (Events Manager → Testar eventos → "Testar eventos do servidor", ex: TEST12345).
# Só para validar localmente — os eventos do servidor aparecem na aba "Testar eventos".
# ⚠️ NUNCA setar em produção (Vercel): desvia os eventos reais para o modo de teste.
META_CAPI_TEST_CODE=""

# --- Google Tag Manager (caminho do GA4) ---
# ID do container (GTM-XXXXXXX). Sem ele, o GTM não carrega e o GA4 não recebe nada.
# O GA4 vive DENTRO do container do GTM (tag de configuração GA4 + tags de evento ouvindo o dataLayer).
# Os eventos do site (view_item, begin_checkout, generate_lead, contact, cta_click, page_view) chegam via dataLayer.
NEXT_PUBLIC_GTM_ID=""

# --- URL pública do site (SEO/canonical) — usada a partir do Sprint 9 ---
# Também usada pelo `pnpm telegram:setup` para montar a URL do webhook do Telegram.
NEXT_PUBLIC_SITE_URL="https://www.comprasparaguay.online"

# --- Telegram Mini-CRM (notificação de lead + "Assumir Lead" anti-colisão) ---
# Fluxo: novo lead → o bot posta no GRUPO de vendedores com o botão [🙋‍♂️ Assumir Lead];
# quem clica primeiro "trava" o lead (UPDATE atômico) e recebe o botão wa.me do cliente.
# Comunicação 100% via HTTP/webhook (serverless — SEM long-polling).
#
# 1) TOKEN do bot: BotFather → /newbot. SECRETO. Sem ele, a notificação vira no-op.
TELEGRAM_BOT_TOKEN=""
# 2) ID do GRUPO da AGÊNCIA ("Compras Paraguay - Leads"; número NEGATIVO, ex: -1001234567890).
#    ⚠️ MIGRAÇÃO 1× (PA §15): este valor é IMPORTADO uma única vez para o admin na primeira leitura e,
#    a partir daí, o grupo da agência se administra NO PAINEL (/admin/dashboard/oferta → "Ação para
#    parceiros" → "ID do grupo Telegram da agência"), sem env/commit/push. Novas instalações podem deixar
#    vazio e definir tudo no admin. Os grupos POR NICHO (pizzaria, cervejaria, etc.) também vivem no admin
#    (tabela partner_lead_settings, Neon). Como obter um chat_id: adicione o bot ao grupo, mande uma
#    mensagem e cheque https://api.telegram.org/bot<TOKEN>/getUpdates (campo chat.id) — ou use @RawDataBot.
TELEGRAM_CHAT_ID=""
# 3) Segredo do webhook (ex: openssl rand -hex 32). O Telegram o reenvia no header
#    X-Telegram-Bot-Api-Secret-Token; a rota /api/telegram-webhook rejeita quem não bater.
TELEGRAM_WEBHOOK_SECRET=""
# 4) (opcional) sobrescreve a URL do webhook no `pnpm telegram:setup` (default: NEXT_PUBLIC_SITE_URL + /api/telegram-webhook)
TELEGRAM_WEBHOOK_URL=""
# 5) (opcional, DEV) ping de lead pendente (lib/lead-alerts.ts) manda pra este chat em vez do grupo real
#    da agência quando NODE_ENV !== "production" — protege o grupo de produção de testes locais.
TELEGRAM_TEST_CHAT_ID=""
# 6) Segredo do cron externo (ex: cron-job.org, a cada 30min) que chama GET/POST
#    /api/cron/lead-alert?secret=<isto> — sem match, 401. Gere com `openssl rand -hex 32`.
CRON_SECRET=""

# --- Anti-bot do modal: Cloudflare Turnstile (CAPTCHA invisível, grátis) ---
# Crie um widget em Cloudflare Dashboard → Turnstile → Add site (domínio do site). Modo "Managed" (recomendado).
# SEM as duas chaves, o modal funciona normal (no-op, sem proteção). Com as duas, o token é exigido e
# validado no servidor (/api/leads) antes de gravar/rotear o lead. Em localhost, use o domínio "localhost" no widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""   # chave PÚBLICA (site key) — vai pro client
TURNSTILE_SECRET_KEY=""             # chave SECRETA — só servidor (nunca commitar)

# --- Auth admin / e-mail (Resend) — Sprint 7 ---
RESEND_API_KEY=""
ADMIN_EMAIL="comprasparaguay@gmail.com"   # ÚNICO e-mail autorizado a receber link mágico
AUTH_SECRET=""                            # segredo p/ assinar o cookie de sessão (openssl rand -base64 32)
# Remetente. Sem domínio verificado, o Resend só envia para o e-mail dono da conta.
# Com domínio verificado: "Compras Paraguay <acesso@comprasparaguay.online>"
# Use um endereço do domínio verificado no Resend (ex.: comprasparaguay.online).
# onboarding@resend.dev SÓ envia para o e-mail da conta Resend (modo teste).
EMAIL_FROM="Compras Paraguay <noreply@comprasparaguay.online>"
# ⚠️ A mesma RESEND_API_KEY também envia o formulário de /contato (app/api/contact/route.ts) para
# comprasparaguay@gmail.com (fixo no código, lib/email.ts, constante CONTACT_EMAIL — mesma caixa do
# ADMIN_EMAIL acima). Sem domínio verificado no Resend, a conta só entrega para o e-mail dono da conta
# Resend — como é o mesmo endereço já usado no magic-link, o envio já deve funcionar sem passo extra.
